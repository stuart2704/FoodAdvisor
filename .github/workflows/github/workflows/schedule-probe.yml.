name: Schedule probe
on:
  schedule:
    - cron: "11,26,41,56 * * * *"
permissions: {}
jobs:
  probe:
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Record scheduled event
        run: |
          echo "Event: $GITHUB_EVENT_NAME"
          date -u +"Triggered at: %Y-%m-%dT%H:%M:%SZ"
