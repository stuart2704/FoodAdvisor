{
  "expo": {
    "name": "The Food Advisor",
    "slug": "restaurant-advisor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "restaurant-advisor-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "The Food Advisor uses your location to show restaurants nearby when you tap Near me."
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", "expo-location"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
