modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-pages-browser"

[[workflows.workflow]]
name = "admin-pages-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter restaurant-advisor-web run test:admin-browser"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "libdrm", "libxkbcommon", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXfixes", "xorg.libXrandr", "mesa", "alsa-lib", "pango", "cairo", "libgbm"]

[userenv]

[userenv.shared]
PUBLIC_APP_URL = "https://www.thefoodadvisor.co.uk"
GMAIL_PUBSUB_SUBSCRIPTION = "projects/the-food-advisor/subscriptions/gmail-replies-sub-2"
GMAIL_PUBSUB_TOPIC = "projects/the-food-advisor/topics/gmail-replies"
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT = "gmail-listener@the-food-advisor.iam.gserviceaccount.com"
ADMIN_EMAIL = "stuart@thefoodadvisor.co.uk"
DAILY_OUTREACH_SCHEDULER_ENABLED = "true"
INSTANTLY_CAMPAIGN_ACTIVATION_ENABLED = "true"
INSTANTLY_CAMPAIGN_CREATION_ENABLED = "true"
INSTANTLY_EACCOUNT = "stuart.cornelius@emailfoodadvisor.com"
OUTREACH_ENABLED = "true"
FACEBOOK_CONFIG_ID = "1813082853220482"

[userenv.development]
STRIPE_PREMIUM_PRICE_ID = "price_1UGcbNLlQZ1xACZup6fdLSok"
INSTAGRAM_REDIRECT_URI = "https://c0df53f2-83a9-4aa9-b71c-d948900574e9-00-261t9n7vhk1ls.worf.replit.dev/admin/social/instagram/callback"
TIKTOK_REDIRECT_URI = "https://c0df53f2-83a9-4aa9-b71c-d948900574e9-00-261t9n7vhk1ls.worf.replit.dev/admin/social/tiktok/callback"

[userenv.production]
