TIKTOK_REDIRECT_URI = "https://www.thefoodadvisor.co.uk/admin/social/tiktok/callback"
SOCIAL_AUTOMATION_ENABLED = "true"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
