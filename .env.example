# Neon remains preferred when both database variables are present.
NEON_DATABASE_URL=
DATABASE_URL=

# Existing Google Places importer.
GOOGLE_MAPS_API_KEY=
GOOGLE_MONTHLY_BUDGET_CENTS=2500

# Outreach is fail-closed. Enable only after the canonical HTTPS URL is live.
PUBLIC_APP_URL=https://thefoodadvisor.co.uk
OUTREACH_ENABLED=false
OUTREACH_DAILY_LIMIT=20
# Generate a random value of at least 32 characters; send it as a Bearer token.
AUTOMATION_TOKEN=

# Existing Stripe price only. It must be active, recurring monthly, GBP 9900.
# Stripe and Gmail credentials come from Replit connectors, never this file.
STRIPE_MONTHLY_PRICE_ID=

# Gmail API access comes only from the Replit google-mail connector. These
# Pub/Sub identifiers are not secrets; do not configure service-account keys.
GMAIL_PUBSUB_TOPIC=projects/the-food-advisor/topics/gmail-replies
GMAIL_PUBSUB_SUBSCRIPTION=projects/the-food-advisor/subscriptions/gmail-replies-sub-2
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=
# Enable only after watch activation, on an always-running server.
# Runs Mondays at 03:00 server time; weekly renewal has no expiry safety margin.
# Keep disabled on Autoscale and use an external scheduler.
GMAIL_WATCH_RENEWAL_ENABLED=false
# Hourly health check; may activate a missing watch when explicitly enabled.
# Requires a live push endpoint and an always-running server.
GMAIL_WATCH_HEALTH_CHECK_ENABLED=false
# Optional: configure SLACK_WEBHOOK_URL using Secrets, never commit its value.

# Instantly reply webhooks are disabled until explicitly enabled. Store the
# secret in server environment/Secrets; never put it in a webhook URL.
INSTANTLY_WEBHOOK_ENABLED=false
INSTANTLY_WEBHOOK_SECRET=